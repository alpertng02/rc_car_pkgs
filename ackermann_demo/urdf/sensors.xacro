<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="lipo_blue"> <color rgba="0.0 0.0 0.8 1.0"/> </material>
  <material name="black_lidar"> <color rgba="0.1 0.1 0.1 1.0"/> </material>
  <material name="raspberry_green"> <color rgba="0.0 0.4 0.0 1.0"/> </material>

  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.015 0.005"/>
      </geometry>
      <material name="black"/>
    </visual>
    <inertial>
      <mass value="0.005"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.000001" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.000001"/>
    </inertial>
  </link>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100.0</update_rate>
      <visualize>true</visualize>
      <topic>__default_topic__</topic>
      
      <plugin name="ackermann_imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <remapping>~/out:=/imu</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>

      <imu>
        <angular_velocity>
          <x><type>gaussian</type><mean>0.0</mean><stddev>2e-4</stddev></x>
          <y><type>gaussian</type><mean>0.0</mean><stddev>2e-4</stddev></y>
          <z><type>gaussian</type><mean>0.0</mean><stddev>2e-4</stddev></z>
        </angular_velocity>
        <linear_acceleration>
          <x><type>gaussian</type><mean>0.0</mean><stddev>1.7e-2</stddev></x>
          <y><type>gaussian</type><mean>0.0</mean><stddev>1.7e-2</stddev></y>
          <z><type>gaussian</type><mean>0.0</mean><stddev>1.7e-2</stddev></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <joint name="imu_joint" type="fixed">
    <parent link="chassis"/>
    <child link="imu_link"/>
    <origin xyz="0.0 0.0 0.01" rpy="0 0 0"/>
  </joint>

  <joint name="battery_joint" type="fixed">
    <parent link="chassis"/>
    <child link="battery_link"/>
    <origin xyz="0 0 0.032" rpy="0 0 0"/> 
  </joint>

  <link name="battery_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry> <box size="0.14 0.0435 0.021"/> </geometry>
      <material name="lipo_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry> <box size="0.135 0.042 0.021"/> </geometry>
    </collision>
    <inertial>
      <mass value="0.25"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="${(1/12)*0.25*(0.042*0.042 + 0.021*0.021)}" ixy="0.0" ixz="0.0"
               iyy="${(1/12)*0.25*(0.135*0.135 + 0.021*0.021)}" iyz="0.0"
               izz="${(1/12)*0.25*(0.135*0.135 + 0.042*0.042)}"/>
    </inertial>
  </link>

  <gazebo reference="battery_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <joint name="jetson_joint" type="fixed">
    <parent link="chassis"/>
    <child link="jetson_link"/>
    <origin xyz="-0.1 -0.025 0.06" rpy="0 0 0"/> 
  </joint>

  <link name="jetson_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find ackermann_demo)/meshes/jetson_orin_nano.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="chassis"/>
    <child link="laser_frame"/>
    <origin xyz="0.068 0 0.096" rpy="0 0 ${M_PI}"/>
  </joint>

  <link name="laser_frame">
    <visual>
      <origin xyz="0 0 -0.01" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find ackermann_demo)/meshes/rplidar_a1.STL" />
      </geometry>
      <material name="black_lidar"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.01" rpy="0 0 0"/>
      <geometry> <cylinder radius="0.035" length="0.05"/> </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <gazebo reference="laser_frame">
    <material>Gazebo/Black</material>
    <sensor name="laser" type="ray">
      <pose> 0 0 0 0 0 0 </pose>
      <visualize>true</visualize>
      <update_rate>10.0</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>800</samples>
            <resolution>1</resolution>
            <min_angle>${-M_PI}</min_angle>
            <max_angle>${M_PI}</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.012</stddev>
        </noise>
      </ray>
      <plugin name="laser_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan_raw</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <joint name="ultrasonic_joint" type="fixed">
    <parent link="chassis"/>
    <child link="ultrasonic_link"/>
    <origin xyz="0.11 0 -0.01" rpy="0 0 0"/>
  </joint>

  <link name="ultrasonic_link">
    <visual>
      <origin rpy="${M_PI / 2} ${M_PI} ${M_PI / 2}" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find ackermann_demo)/meshes/hc-sr-04.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.000001" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.000001"/>
    </inertial>
  </link>

  <gazebo reference="ultrasonic_link">
    <material>Gazebo/Blue</material>
    <sensor name="hcsr04" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize> 
      <update_rate>20.0</update_rate> 
      <ray>
        <scan>
          <horizontal>
            <samples>10</samples>
            <resolution>1</resolution>
            <min_angle>-0.13</min_angle> 
            <max_angle>0.13</max_angle>  
          </horizontal>
          <vertical>
            <samples>10</samples>
            <resolution>1</resolution>
            <min_angle>-0.005</min_angle>
            <max_angle>0.0628</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.02</min> 
          <max>4.0</max>  
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.03</stddev>
        </noise>
      </ray>
      <plugin name="ultrasonic_sensor" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=ultrasonic/range</remapping>
        </ros>
        <output_type>sensor_msgs/Range</output_type>
        <radiation_type>ultrasound</radiation_type>
        <frame_name>ultrasonic_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <joint name="camera_joint" type="fixed">
    <parent link="chassis"/>
    <child link="camera_link"/>
    <origin xyz="0.086 0 0.033" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.005 0.025 0.025"/>
      </geometry>
      <material name="raspberry_green"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry> <box size="0.005 0.025 0.025"/> </geometry>
    </collision>
    <inertial>
      <mass value="0.005"/>
      <inertia ixx="0.0000001" ixy="0.0" ixz="0.0" iyy="0.0000001" iyz="0.0" izz="0.0000001"/>
    </inertial>
  </link>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
    <origin xyz="0 0 0" rpy="-${M_PI/2} 0 -${M_PI/2}"/>
  </joint>

  <link name="camera_link_optical"/>

  <gazebo reference="camera_link">
    <material>Gazebo/Green</material>
    <sensor name="rasppi_camera" type="camera">
      <pose> 0 0 0 0 0 0 </pose>
      <visualize>true</visualize>
      <update_rate>30.0</update_rate>
      <camera>
        <horizontal_fov>1.085595</horizontal_fov>
        <image>
          <format>R8G8B8</format>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.05</near>
          <max>8.0</max>
        </clip>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <frame_name>camera_link_optical</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>